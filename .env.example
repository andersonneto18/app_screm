# ---------------------------------------------------------------------------
# ScreenRoom environment variables
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL (Neon / Supabase / self-hosted). Pooled URL for the app.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Optional direct (non-pooled) URL for migrations against Neon.
DIRECT_URL=""

# Auth.js — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""

# Public base URL of the app (used for invite links, LiveKit redirects).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# LiveKit — SECRET must stay server-side only.
LIVEKIT_URL="ws://localhost:7880"
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret_change_me_at_least_32_chars_long"

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Redis (optional — rate limiting falls back to in-memory if unset)
REDIS_URL=""
