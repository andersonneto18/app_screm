# ---------------------------------------------------------------------------
# ScreenRoom environment variables
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL (Neon / Supabase / self-hosted). Pooled URL for the app.
# Use sslmode=verify-full with a managed provider (valid certs); the pg driver
# warns on bare sslmode=require.
DATABASE_URL="postgresql://user:password@host/db?sslmode=verify-full"
# Direct (non-pooled) URL for Prisma Migrate — the non-pooler host on Neon.
DIRECT_URL="postgresql://user:password@host/db?sslmode=verify-full"

# Auth.js — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""

# Public base URL of the app (used for invite links, LiveKit redirects).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# LiveKit — SECRET must stay server-side only.
# Local (docker compose): ws://localhost:7880 with devkey/devsecret.
# LiveKit Cloud: wss://<project>.livekit.cloud + the project's API key/secret.
LIVEKIT_URL="wss://your-project.livekit.cloud"
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="APIxxxxxxxxxxxx"
LIVEKIT_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Redis (optional — rate limiting falls back to in-memory if unset)
REDIS_URL=""

# Platform admins — comma-separated emails. These accounts get host controls
# (screen share, kick, end) in every room plus the /admin panel.
ADMIN_EMAILS=""

# Vercel Blob — room cover uploads. Create a Blob store in the Vercel
# dashboard (Storage → Blob) and this is injected automatically. Optional:
# without it, covers can still be set by pasting an image URL.
BLOB_READ_WRITE_TOKEN=""
